<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>pe.edu.vallegrande</groupId>
    <artifactId>Arquitectura</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Arquitectura</name>
    <description>Arquitectura</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <!-- ========== SPRING BOOT CORE DEPENDENCIES ========== -->
        
        <!-- Spring Boot Data JPA: Persistencia de datos con JPA/Hibernate -->
        <!-- Incluye: JPA, Hibernate, configuración automática de repositorios -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- Spring Boot Data REST: Expone repositorios JPA como endpoints REST automáticamente -->
        <!-- Genera APIs REST CRUD sin escribir controladores manualmente -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-rest</artifactId>
        </dependency>
        
        <!-- Spring Boot Web: Desarrollo de aplicaciones web y APIs REST -->
        <!-- Incluye: Tomcat embebido, Spring MVC, Jackson JSON, validación -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ========== DEVELOPMENT TOOLS ========== -->
        
        <!-- Spring Boot DevTools: Herramientas de desarrollo -->
        <!-- Incluye: recarga automática, LiveReload, configuraciones de desarrollo -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ========== DATABASE DRIVERS ========== -->
        
        <!-- SQL Server JDBC Driver (COMENTADO - Ya no se usa) -->
        <!-- Driver para conectar con Microsoft SQL Server -->
<!--
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
-->

        <!-- Oracle JDBC Driver: Conexión a base de datos Oracle (ACTIVO) -->
        <!-- Incluye: ojdbc11, herramientas de conexión Oracle, soporte UCP -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11-production</artifactId>
            <version>21.5.0.0</version>
            <type>pom</type>
        </dependency>
        
        <!-- H2 Database: Base de datos en memoria para desarrollo (COMENTADO TEMPORALMENTE) -->
        <!-- Incluye: H2 Engine, consola web, ideal para testing y desarrollo -->
        <!--
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        -->
        
        <!-- ========== TESTING FRAMEWORK ========== -->
        
        <!-- Spring Boot Testing: Suite completa de pruebas -->
        <!-- Incluye: JUnit 5, Mockito, AssertJ, Hamcrest, Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- ========== MONITORING & MANAGEMENT ========== -->
        
        <!-- Spring Boot Actuator: Endpoints de monitoreo y administración -->
        <!-- Incluye: /health, /metrics, /info, /env para producción y DevOps -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        
        <!-- ========== CODE GENERATION ========== -->
        
        <!-- Lombok: Reducción de código boilerplate -->
        <!-- Genera automáticamente: getters, setters, constructores, toString, equals -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- ========== REPORT GENERATION ========== -->
        
        <!-- JasperReports Core: Librería para generar reportes -->
        <!-- Genera reportes en PDF, Excel, Word | fontName="Times New Roman" -> fontName="SansSerif" -->
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>6.21.3</version>
            <!-- Evitamos conflictos de dependencias -->
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-beanutils</groupId>
                    <artifactId>commons-beanutils</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        
        <!-- JasperReports Fonts: Fuentes adicionales para reportes -->
        <!-- Proporciona fuentes embebidas para mejorar la apariencia de reportes -->
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-fonts</artifactId>
            <version>6.21.3</version>
        </dependency>

        <!-- ========== AUTHENTICATION & SECURITY ========== -->
        
        <!-- JWT API: Interfaces para JSON Web Tokens -->
        <!-- Define las interfaces y contratos para el manejo de JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        
        <!-- JWT Implementation: Implementación concreta de JWT -->
        <!-- Contiene la lógica de creación, parseo y validación de tokens -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        
        <!-- JWT Jackson Integration: Serialización JSON para JWT -->
        <!-- Integra Jackson para convertir objetos Java a/desde JSON en tokens -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Security: Framework de seguridad completo -->
        <!-- Incluye: autenticación, autorización, protección CSRF, CORS, filtros -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
